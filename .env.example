# คีย์ใส่ได้ 2 ทาง เลือกทางไหนก็ได้
#
#  1) ใส่ในหน้าเว็บ — กดปุ่ม 🔑 บนแถบบน (คีย์เก็บใน localStorage ของเบราว์เซอร์เท่านั้น)
#     เหมาะกับให้คนอื่นมาลองเล่นด้วยคีย์ของเขาเอง
#
#  2) ใส่ในไฟล์นี้ — คัดลอกเป็น .env.local แล้วเติมคีย์ (คีย์ในหน้าเว็บจะถูกใช้ก่อนเสมอ)
#
# ไม่ใส่เลยก็รันได้ — ระบบจะเข้าโหมดสาธิต (animation ครบ แต่คำตอบเป็นข้อความตัวอย่าง)

# --- Claude (Anthropic) --- ต้องมีเครดิตในบัญชี (subscription Max/Pro ใช้กับ API ไม่ได้)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# --- Gemini (Google) --- มี free tier
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# ถ้าใส่ทั้งสองคีย์ ระบุว่าจะใช้อันไหน: anthropic | gemini
# ไม่ระบุ = ใช้อันที่มีคีย์ (Claude มาก่อน)
# LLM_PROVIDER=gemini


# ============================================================
# Supabase — สำหรับ Sign In + Create My Office + จ้างแล้วไม่หาย
# ไม่ใส่ก็รันได้ แอปจะทำงานแบบในเครื่องอย่างเดียว (รีเฟรชแล้วพนักงานหาย)
#
# วิธีเปิดใช้:
#   1. สร้างโปรเจกต์ที่ supabase.com
#   2. เอา supabase/schema.sql ไปรันใน SQL Editor
#   3. คัดค่าสองอันล่างจาก Project Settings → API
#   4. รีสตาร์ท dev server
#
# คีย์ฝั่ง client ใส่ได้ทั้งชื่อใหม่และชื่อเก่า ใครมีอันไหนก็ใช้อันนั้น
#   ชื่อใหม่: PUBLISHABLE_KEY = sb_publishable_...   (Supabase ใช้ชื่อนี้แล้ว)
#   ชื่อเก่า: ANON_KEY        = JWT ยาว ๆ
# ทั้งคู่ปลอดภัยที่จะให้เบราว์เซอร์เห็น เพราะ RLS ใน Postgres ยังบังคับอยู่
#
# ห้ามเอา secret key (sb_secret_...) หรือ service_role มาใส่เด็ดขาด
# สองอันนั้นข้าม RLS ได้ทั้งหมด แอปจะเตือนให้ถ้าเผลอใส่
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
